DATABASE_URL=sqlite:///./aquashield.db
# MySQL: mysql+pymysql://aquashield:password@localhost:3306/aquashield
# Required by `docker compose up`; use two different random alphanumeric passwords.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Firebase team mode. Obtain the JSON service account file separately; never commit it.
AUTH_MODE=firebase
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_PATH=secrets/service-account.json
FIREBASE_DATABASE_URL=https://YOUR-DATABASE.asia-southeast1.firebasedatabase.app

# Set true only after obtaining the broker credentials/configuration from the broker admin.
MQTT_ENABLED=false
MQTT_HOST=mqtt.bifriends.my.id
MQTT_PORT=9001
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=true
MQTT_TRANSPORT=websockets
MQTT_WEBSOCKET_PATH=/mqtt

# Local development only: AUTH_MODE=development and set a token of at least 24 chars.
DEV_API_TOKEN=
CORS_ORIGINS=["http://localhost:8081"]
